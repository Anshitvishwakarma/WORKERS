                    </div>
                </div>

                <!-- Dashboard Tabs Navigation -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-2">
                        <ul class="nav nav-pills nav-fill" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link prov-nav-btn active fw-semibold" id="btn-prov-tab-requests"
                                    onclick="App.showProviderTab('requests')">
                                    <i class="bi bi-inbox me-2"></i> Incoming Requests
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link prov-nav-btn fw-semibold" id="btn-prov-tab-active"
