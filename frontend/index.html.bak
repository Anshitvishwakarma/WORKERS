                <!-- Tab 5: Profile -->
                <div id="prov-tab-profile" class="prov-tab-content" style="display: none;">
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="card shadow-sm border-0 p-4">
                                <h5 class="fw-bold mb-3"><i class="bi bi-briefcase me-2 text-primary"></i> Business &
                                    Contact Info</h5>
                                <form id="provProfileForm" onsubmit="Provider.updateProfile(event)">
                                    <div class="mb-3">
                                        <label for="provProfileEmail" class="form-label small fw-semibold">Email Address
                                            (Read-only)</label>
                                        <input type="email" id="provProfileEmail" class="form-control" disabled>
                                    </div>
                                    <div class="mb-3">
                                        <label for="provProfileName" class="form-label small fw-semibold">Business /
                                            Full Name</label>
                                        <input type="text" id="provProfileName" class="form-control" required
                                            minlength="2">
                                    </div>
                                    <div class="mb-3">
                                        <label for="provProfilePhone" class="form-label small fw-semibold">Business
                                            Phone Number</label>
                                        <input type="tel" id="provProfilePhone" class="form-control" required>
                                    </div>
                                    <div class="mb-3">
                                        <label for="provProfileAddress" class="form-label small fw-semibold">Workshop /
                                            Service Base Address</label>
                                        <textarea id="provProfileAddress" class="form-control" rows="3"
                                            required></textarea>
                                    </div>
                                    <button type="submit" id="btnProvSaveProfile" class="btn btn-primary fw-semibold">
                                        Save Changes
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="card shadow-sm border-0 p-4">
                                <h5 class="fw-bold mb-3"><i class="bi bi-shield-lock me-2 text-primary"></i> Security &
                                    Password</h5>
                                <form id="provChangePassForm" onsubmit="Provider.changePassword(event)">
                                    <div class="mb-3">
                                        <label for="provOldPassword" class="form-label small fw-semibold">Current
                                            Password</label>
                                        <input type="password" id="provOldPassword" class="form-control" required>
                                    </div>
                                    <div class="mb-3">
                                        <label for="provNewPassword" class="form-label small fw-semibold">New
                                            Password</label>
                                        <input type="password" id="provNewPassword" class="form-control" required
                                            minlength="6">
                                    </div>
                                    <div class="mb-4">
                                        <label for="provConfirmPassword" class="form-label small fw-semibold">Confirm
                                            New Password</label>
                                        <input type="password" id="provConfirmPassword" class="form-control" required
                                            minlength="6">
                                    </div>
                                    <button type="submit" id="btnProvChangePass"
                                        class="btn btn-outline-primary fw-semibold">
                                        Update Password
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>


        <!-- ============================================================= -->
        <!-- VIEW 6: ADMIN DASHBOARD -->
        <!-- ============================================================= -->
        <section id="view-admin" class="view-section py-4" style="display: none;">
            <div class="container">
                <!-- Welcome Banner & KPIs -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h2 class="fw-bold mb-1">FixMate Platform Administration</h2>
                        <p class="text-muted mb-0">Full control over users, service offerings, bookings, and revenue
                            analytics.</p>
                    </div>
                    <div class="mt-2 mt-sm-0">
                        <button class="btn btn-outline-primary btn-sm" onclick="Admin.init()">
                            <i class="bi bi-arrow-clockwise me-1"></i> Refresh Metrics
                        </button>
                    </div>
                </div>

                <!-- Admin KPI Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-icon bg-primary text-white"><i class="bi bi-people"></i></div>
                            <div>
                                <h3 class="fw-bold mb-0" id="adminStatUsers">0</h3>
                                <span class="small text-muted">Total Registered Users</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-icon bg-info text-white"><i class="bi bi-person-badge"></i></div>
                            <div>
                                <h3 class="fw-bold mb-0" id="adminStatProviders">0</h3>
                                <span class="small text-muted">Service Providers</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-icon bg-warning text-dark"><i class="bi bi-calendar-event"></i></div>
                            <div>
                                <h3 class="fw-bold mb-0" id="adminStatBookings">0</h3>
                                <span class="small text-muted">Total Bookings</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-icon bg-success text-white"><i class="bi bi-cash-stack"></i></div>
                            <div>
                                <h3 class="fw-bold mb-0" id="adminStatRevenue">$0.00</h3>
                                <span class="small text-muted">Completed Gross Revenue</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Admin Tabs Navigation -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-2">
                        <ul class="nav nav-pills nav-fill" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link admin-nav-btn active fw-semibold" id="btn-admin-tab-users"
                                    onclick="App.showAdminTab('users')">
                                    <i class="bi bi-people me-2"></i> Users Management
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link admin-nav-btn fw-semibold" id="btn-admin-tab-services"
                                    onclick="App.showAdminTab('services')">
                                    <i class="bi bi-grid me-2"></i> Services Catalog
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link admin-nav-btn fw-semibold" id="btn-admin-tab-bookings"
                                    onclick="App.showAdminTab('bookings')">
                                    <i class="bi bi-journal-text me-2"></i> All Bookings
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Tab 1: Users Management -->
                <div id="admin-tab-users" class="admin-tab-content">
                    <div class="card border-0 shadow-sm mb-3 p-3">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent border-end-0"><i
                                            class="bi bi-search text-muted"></i></span>
                                    <input type="text" id="adminUserSearchInput" class="form-control border-start-0"
                                        placeholder="Search by name, email, or phone..." oninput="Admin.filterUsers()">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <select id="adminUserRoleFilter" class="form-select" onchange="Admin.filterUsers()">
                                    <option value="">All Roles</option>
                                    <option value="CUSTOMER">Customers Only</option>
                                    <option value="PROVIDER">Providers Only</option>
                                    <option value="ADMIN">Admins Only</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-outline-secondary w-100"
                                    onclick="document.getElementById('adminUserSearchInput').value=''; document.getElementById('adminUserRoleFilter').value=''; Admin.filterUsers()">
                                    Reset
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive bg-white rounded shadow-sm">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>User & Address</th>
                                    <th>Email / Phone</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Created At</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="adminUsersTableBody">
                                <!-- Populated dynamically via Admin.renderUsers() -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 2: Services Catalog -->
                <div id="admin-tab-services" class="admin-tab-content" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Platform Service Categories</h5>
                        <button class="btn btn-primary btn-sm" onclick="Admin.openAddServiceModal()">
                            <i class="bi bi-plus-circle me-1"></i> Add Service Category
                        </button>
                    </div>

                    <div class="table-responsive bg-white rounded shadow-sm">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Service Name</th>
                                    <th>Description</th>
                                    <th>Icon Class</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="adminServicesTableBody">
                                <!-- Populated dynamically via Admin.renderServices() -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 3: Platform Bookings -->
                <div id="admin-tab-bookings" class="admin-tab-content" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">All Customer Bookings</h5>
                        <div class="col-md-3">
                            <select id="adminBookingStatusFilter" class="form-select form-select-sm"
                                onchange="Admin.filterBookings()">
                                <option value="">All Statuses</option>
                                <option value="PENDING">PENDING</option>
                                <option value="ACCEPTED">ACCEPTED</option>
                                <option value="COMPLETED">COMPLETED</option>
                                <option value="CANCELLED">CANCELLED</option>
                                <option value="REJECTED">REJECTED</option>
                            </select>
                        </div>
                    </div>

                    <div class="table-responsive bg-white rounded shadow-sm">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Customer</th>
                                    <th>Provider</th>
                                    <th>Service</th>
                                    <th>Scheduled Date & Time</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="adminBookingsTableBody">
                                <!-- Populated dynamically via Admin.renderBookings() -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </section>

    </main>


    <!-- ================================================================= -->
    <!-- MODAL 1: CUSTOMER CREATE BOOKING -->
    <!-- ================================================================= -->
    <div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="bookingModalLabel">
                        <i class="bi bi-calendar-plus me-1"></i> Book Service
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <form id="createBookingForm" onsubmit="Customer.submitBooking(event)">
                    <div class="modal-body p-4">
                        <!-- Service & Provider Summary Card -->
                        <div class="p-3 bg-light rounded mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="fw-bold mb-0" id="bookServiceName">Service Name</h6>
                                <span class="fs-5 fw-bold text-primary" id="bookPricePreview">$0.00</span>
                            </div>
                            <div class="small text-muted" id="bookProviderName">Provider Name</div>
                            <div class="small text-secondary mt-1" id="bookAvailabilityNote">Availability</div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="bookDate" class="form-label small fw-semibold">Preferred Date</label>
                                <input type="date" id="bookDate" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label for="bookTime" class="form-label small fw-semibold">Preferred Time</label>
                                <input type="time" id="bookTime" class="form-control" value="10:00" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="bookAddress" class="form-label small fw-semibold">Service Address</label>
                            <input type="text" id="bookAddress" class="form-control"
                                placeholder="House/Apt, Street Address" required>
                        </div>

                        <div class="mb-2">
                            <label for="bookDescription" class="form-label small fw-semibold">Problem Description /
                                Notes (Optional)</label>
                            <textarea id="bookDescription" class="form-control" rows="3"
                                placeholder="Describe the issue or any specific requirements for the technician..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="btnConfirmBooking" class="btn btn-primary px-4 fw-semibold">
                            Confirm Booking
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <!-- ================================================================= -->
    <!-- MODAL 2: PROVIDER SERVICE OFFERING (ADD / EDIT) -->
    <!-- ================================================================= -->
    <div class="modal fade" id="providerServiceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="provServiceModalTitle">Add Service Offering</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="providerServiceForm" onsubmit="Provider.saveServiceOffering(event)">
                    <div class="modal-body p-4">
                        <div class="mb-3" id="provServiceSelectGroup">
                            <label for="provModalServiceSelect" class="form-label small fw-semibold">Select Service
                                Category</label>
                            <select id="provModalServiceSelect" class="form-select">
                                <option value="">Select Category</option>
                            </select>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="provModalPrice" class="form-label small fw-semibold">Service Price
                                    ($)</label>
                                <input type="number" id="provModalPrice" class="form-control" step="0.5" min="1"
                                    placeholder="e.g. 75.00" required>
                            </div>
                            <div class="col-md-6">
                                <label for="provModalExp" class="form-label small fw-semibold">Experience
                                    (Years)</label>
                                <input type="number" id="provModalExp" class="form-control" min="0" max="60" value="2"
                                    required>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="provModalAvail" class="form-label small fw-semibold">Weekly Availability /
                                Working Hours</label>
                            <input type="text" id="provModalAvail" class="form-control"
                                placeholder="e.g. Mon-Sat 9AM-6PM, or 24/7" required>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="btnProvSaveService" class="btn btn-primary px-4 fw-semibold">Save
                            Offering</button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <!-- ================================================================= -->
    <!-- MODAL 3: ADMIN SERVICE CATALOG (ADD / EDIT) -->
    <!-- ================================================================= -->
    <div class="modal fade" id="adminServiceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="adminServiceModalTitle">Add Service Category</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="adminServiceForm" onsubmit="Admin.saveService(event)">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label for="adminServiceName" class="form-label small fw-semibold">Service Name</label>
                            <input type="text" id="adminServiceName" class="form-control"
                                placeholder="e.g. Solar Panel Cleaning" required minlength="2">
                        </div>

                        <div class="mb-3">
                            <label for="adminServiceDesc" class="form-label small fw-semibold">Description</label>
                            <textarea id="adminServiceDesc" class="form-control" rows="3"
                                placeholder="Detailed service description..." required></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="adminServiceIcon" class="form-label small fw-semibold">Bootstrap Icon
                                Class</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-tag"></i></span>
                                <input type="text" id="adminServiceIcon" class="form-control"
                                    placeholder="e.g. bi-sun, bi-wrench-adjustable" value="bi-tools">
                            </div>
                            <div class="form-text small">Use any Bootstrap 5 icon class name (e.g.
                                <code>bi-stars</code>, <code>bi-snow</code>).
                            </div>
                        </div>

                        <div class="form-check form-switch mt-3" id="adminServiceActiveGroup" style="display: none;">
                            <input class="form-check-input" type="checkbox" id="adminServiceActive" checked>
                            <label class="form-check-label small fw-semibold" for="adminServiceActive">Active (Visible
                                in catalog)</label>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="btnAdminSaveService" class="btn btn-primary px-4 fw-semibold">Save
                            Service</button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <!-- ================================================================= -->
    <!-- Footer -->
    <!-- ================================================================= -->
    <footer id="contact-section" class="footer-fixmate mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4">
                    <h5 class="text-white fw-bold mb-3">
                        <i class="bi bi-tools text-primary me-1"></i> FixMate
                    </h5>
                    <p class="small text-white-50">
                        FixMate is a full-stack home services booking platform connecting verified, skilled technicians
                        with homeowners for seamless home maintenance.
                    </p>
                    <div class="d-flex gap-3 fs-5 text-white-50">
                        <a href="javascript:void(0)" class="text-white-50"><i class="bi bi-facebook"></i></a>
                        <a href="javascript:void(0)" class="text-white-50"><i class="bi bi-twitter-x"></i></a>
                        <a href="javascript:void(0)" class="text-white-50"><i class="bi bi-instagram"></i></a>
