
 <!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Workers - Reliable Home Services Booking Platform</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Styles -->
    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- ================================================================= -->
    <!-- Navigation Bar -->
    <!-- ================================================================= -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-fixmate sticky-top">
        <div class="container">
            <a class="navbar-brand navbar-brand-logo" href="#home" onclick="App.navigateTo('home')">
                <i class="bi bi-tools brand-icon"></i> WORKERS<span class="text-primary-emphasis"
                    style="color: #60a5fa !important;"></span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
               
<ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
    <li class="nav-item">
        <a class="nav-link active" href="#home"
           onclick="event.preventDefault(); App.navigateTo('home'); window.scrollTo({top: 0, behavior: 'smooth'});">
            Home
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link" href="#services"
           onclick="event.preventDefault(); App.navigateTo('home'); setTimeout(() => document.getElementById('popular-services-section')?.scrollIntoView({behavior: 'smooth', block: 'start'}), 200);">
            Services
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link" href="#contact"
           onclick="event.preventDefault(); document.getElementById('contact-section')?.scrollIntoView({behavior: 'smooth', block: 'start'});">
            Contact
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link fw-semibold text-warning"
           id="navDashboardLink"
           style="display: none;"
           href="javascript:void(0)">
            Dashboard
        </a>
    </li>
</ul>


                <div class="d-flex align-items-center gap-3">
                    <!-- Theme Toggle -->
                  
                    <!-- Unauthenticated Buttons -->
                    <div id="navAuthLinks" class="d-flex gap-2">
                        <button class="btn btn-outline-light btn-sm px-3" onclick="App.navigateTo('login')">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                        <button class="btn btn-primary btn-sm px-3" onclick="App.navigateTo('register')">
                            <i class="bi bi-person-plus me-1"></i> Register
                        </button>
                    </div>

                    <!-- Authenticated User Menu -->
                    <div id="navUserMenu" class="dropdown" style="display: none;">
                        <button class="btn btn-primary btn-sm dropdown-toggle d-flex align-items-center gap-2"
                            type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle fs-6"></i>
                            <span id="navUserName">User</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <h6 class="dropdown-header">Account Management</h6>
                            </li>
                            <li><a class="dropdown-item" href="javascript:void(0)"
                                    onclick="App.navigateTo(Auth.getRole().toLowerCase())"><i
                                        class="bi bi-speedometer2 me-2"></i>My Dashboard</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item text-danger" href="javascript:void(0)"
                                    onclick="App.handleLogout()"><i class="bi bi-box-arrow-right me-2"></i>Logout</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Global Loading Spinner -->
    <div id="globalLoadingSpinner">
        <div class="spinner-border text-primary" style="width: 3.5rem; height: 3.5rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toastContainer"></div>

    <!-- Main Content Views -->
    <main>

        <!-- ============================================================= -->
        <!-- VIEW 1: PUBLIC HOME PAGE -->
        <!-- ============================================================= -->
        <section id="view-home" class="view-section">
            <!-- Hero Banner -->
            <div class="hero-section">
                <div class="container position-relative">
                    <div class="row align-items-center g-5">
                        <div class="col-lg-7">
                            <span class="badge bg-primary text-white mb-3 px-3 py-2 fs-6 rounded-pill">
                                <i class="bi bi-shield-check me-1"></i> Verified & Background-Checked Technicians
                            </span>
                            <h1 class="hero-title mb-4">Reliable Home Services, Right at Your Doorstep</h1>
                            <p class="hero-subtitle mb-4">
                                Book top-rated local plumbers, electricians, cleaners, AC technicians, carpenters, and
                                appliance repair experts with transparent pricing and guaranteed satisfaction.
                            </p>
                            <div class="d-flex flex-wrap gap-3">
                                <button class="btn btn-primary btn-lg px-4" onclick="App.navigateTo('register')">
                                    <i class="bi bi-lightning-charge me-1"></i> Book a Service Now
                                </button>
                                <button class="btn btn-outline-light btn-lg px-4"
                                    onclick="document.getElementById('how-it-works-section').scrollIntoView({behavior: 'smooth'})">
                                    <i class="bi bi-info-circle me-1"></i> Explore How It Works
                                </button>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="hero-search-card shadow-lg">
                                <h4 class="fw-bold mb-3"><i class="bi bi-search me-2 text-primary"></i> Find What You
                                    Need</h4>
                                <p class="text-white-50 small mb-3">Quickly search available services in your area</p>
                                <div class="input-group mb-3">
                                    <span class="input-group-text bg-white text-muted border-0"><i
                                            class="bi bi-geo-alt"></i></span>
                                    <input type="text" class="form-control border-0"
                                        placeholder="Your City or Postal Code" value="Brooklyn, NY" readonly>
                                </div>
                                <div class="input-group mb-3">
                                    <span class="input-group-text bg-white text-muted border-0"><i
                                            class="bi bi-wrench"></i></span>
                                    <input type="text" id="heroQuickSearch" class="form-control border-0"
                                        placeholder="e.g. Plumbing, Electrician, AC">
                                </div>
                                <button class="btn btn-primary w-100 py-2 fw-semibold"
                                    onclick="App.handleServiceBookClick(1)">
                                    <i class="bi bi-arrow-right-circle me-1"></i> Search Service Providers
                                </button>
                                <div
                                    class="mt-3 pt-3 border-top border-white-50 d-flex justify-content-between text-white-50 small">
                                    <span><i class="bi bi-check2-circle text-success me-1"></i> Upfront Pricing</span>
                                    <span><i class="bi bi-check2-circle text-success me-1"></i> Instant Booking</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        
            <!-- Popular Services Grid -->
            <div id="popular-services-section" class="py-5">
                <div class="container py-4">
                    <div class="text-center mb-5">
                        <span class="text-primary fw-bold text-uppercase small letter-spacing-1">Our Core
                            Offerings</span>
                        <h2 class="fw-bold display-6 mt-1">Popular Home Services</h2>
                        <p class="text-muted col-md-8 mx-auto">Explore certified professional services delivered right
                            to your home with transparent hourly or fixed pricing.</p>
                    </div>

                    <div id="publicServicesGrid" class="row g-4">
                        <!-- Populated dynamically via App.loadPublicServices() -->
                    </div>
                </div>
            </div>

            <!-- How It Works Section -->
        

            <!-- Why Choose FixMate Section -->
       











            <!-- Customer Testimonials Section (Clearly Labelled Demo Content) -->
            <div class="py-5 testimonial-section">
                <div class="container py-4">
                    <div class="text-center mb-5">
                        <span class="badge bg-secondary mb-2">Demo User Testimonials</span>
                        <h2 class="fw-bold display-6">Loved by Thousands of Homeowners</h2>
                        <p class="text-muted">Read simulated customer feedback showcasing the platform experience.</p>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-4 testimonial-bg">
                                <div class="d-flex text-warning mb-3">
                                    <i class="bi bi-star-fill me-1"></i><i class="bi bi-star-fill me-1"></i><i
                                        class="bi bi-star-fill me-1"></i><i class="bi bi-star-fill me-1"></i><i
                                        class="bi bi-star-fill"></i>
                                </div>
                                <p class="text-muted small mb-4">"Workers solved my leaking kitchen sink in less than 2
                                    hours. David was punctual, polite, and completely cleaned up the area afterward.
                                    Super easy to book!"</p>
                                <div class="d-flex align-items-center">

                                    <img src="https://randomuser.me/api/portraits/women/44.jpg"
     alt="Customer" class="testimonial-photo me-3">
                                    <div>
                                        <h6 class="mb-0 fw-bold">Emily Martinez</h6>
                                        <span class="small text-muted">Customer (Springfield) - Demo Review</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-4">
                                <div class="d-flex text-warning mb-3">
                                    <i class="bi bi-star-fill me-1"></i><i class="bi bi-star-fill me-1"></i><i
                                        class="bi bi-star-fill me-1"></i><i class="bi bi-star-fill me-1"></i><i
                                        class="bi bi-star-fill"></i>
                                </div>
                                <p class="text-muted small mb-4">"As an electrician on FixMate, I receive consistent
                                    weekly client bookings without spending money on marketing. The dashboard makes
                                    managing jobs effortless."</p>
                                <div class="d-flex align-items-center">
<img src="https://randomuser.me/api/portraits/women/68.jpg"
     alt="Provider" class="testimonial-photo me-3">                                    <div>
                                        <h6 class="mb-0 fw-bold">Elena Rostova</h6>
                                        <span class="small text-muted">Electrician Provider (Queens, NY) - Demo
                                            Review</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-4">
                                <div class="d-flex text-warning mb-3">
                                    <i class="bi bi-star-fill me-1"></i><i class="bi bi-star-fill me-1"></i><i
                                        class="bi bi-star-fill me-1"></i><i class="bi bi-star-fill me-1"></i><i
                                        class="bi bi-star-fill"></i>
                                </div>
                                <p class="text-muted small mb-4">"Transparent prices with no haggling. The AC repair
                                    technician refilled the refrigerant and tuned the air filter in 45 minutes. Highly
                                    recommended!"</p>
                                <div class="d-flex align-items-center">
<img src="https://randomuser.me/api/portraits/men/32.jpg"
     alt="Customer" class="testimonial-photo me-3">                                    <div>
                                        <h6 class="mb-0 fw-bold">Robert Chen</h6>
                                        <span class="small text-muted">Customer (Brooklyn, NY) - Demo Review</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Provider CTA Banner -->
            <div class="py-5 text-center text-white"
                style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
                <div class="container py-3">
                    <h3 class="fw-bold mb-3">Are You an Experienced Service Professional?</h3>
                 
                    <button class="btn btn-primary btn-lg px-4"
                        onclick="App.navigateTo('register'); document.getElementById('regRoleProvider').checked = true;">
                        <i class="bi bi-briefcase me-1"></i> Join as a Service Provider
                    </button>
                </div>
            </div>
        </section>


        <!-- ============================================================= -->
        <!-- VIEW 2: AUTHENTICATION - LOGIN PAGE -->
        <!-- ============================================================= -->
        <section id="view-login" class="view-section py-5" style="display: none;">
            <div class="container py-4">
                <div class="row justify-content-center">
                    <div class="col-md-7 col-lg-5">
                        <div class="card shadow-sm border-0 p-4">
                            <div class="text-center mb-4">
                                <div class="service-icon-box mx-auto mb-2 bg-primary-subtle">
                                    <i class="bi bi-box-arrow-in-right fs-3 text-primary"></i>
                                </div>
                                <h3 class="fw-bold">Sign In to FixMate</h3>
                                <p class="text-muted small">Access your personalized customer, provider, or admin
                                    dashboard</p>
                            </div>

                            <!-- Quick Demo Logins -->
                            <div class="mb-4 p-3 bg-light rounded text-center">
                                <span class="small fw-bold text-muted d-block mb-2">⚡ Quick 1-Click Demo Fill:</span>
                                <div class="d-flex justify-content-center gap-2">
                                    <button type="button" class="btn btn-outline-primary btn-sm"
                                        onclick="App.fillDemoLogin('CUSTOMER')">Customer</button>
                                    <button type="button" class="btn btn-outline-info btn-sm"
                                        onclick="App.fillDemoLogin('PROVIDER')">Provider</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                        onclick="App.fillDemoLogin('ADMIN')">Admin</button>
                                </div>
                            </div>

                            <form id="loginForm" onsubmit="App.handleLogin(event)">
                                <div class="mb-3">
                                    <label for="loginEmail" class="form-label small fw-semibold">Email Address</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                        <input type="email" id="loginEmail" class="form-control"
                                            placeholder="name@example.com" required>
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label for="loginPassword" class="form-label small fw-semibold">Password</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                        <input type="password" id="loginPassword" class="form-control"
                                            placeholder="••••••••" required>
                                    </div>
                                </div>
                                <button type="submit" id="btnLoginSubmit"
                                    class="btn btn-primary w-100 py-2 fw-semibold">
                                    Sign In
                                </button>
                            </form>

                            <div class="mt-4 text-center small text-muted">
                                Don't have an account yet?
                                <a href="#register" onclick="App.navigateTo('register')" class="fw-semibold">Create an
                                    Account</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- ============================================================= -->
        <!-- VIEW 3: AUTHENTICATION - REGISTER PAGE -->
        <!-- ============================================================= -->
        <section id="view-register" class="view-section py-5" style="display: none;">
            <div class="container py-4">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        <div class="card shadow-sm border-0 p-4">
                            <div class="text-center mb-4">
                                <div class="service-icon-box mx-auto mb-2 bg-primary-subtle">
                                    <i class="bi bi-person-plus fs-3 text-primary"></i>
                                </div>
                                <h3 class="fw-bold">Create Your FixMate Account</h3>
                                <p class="text-muted small">Choose your role and register securely</p>
                            </div>

                            <form id="registerForm" onsubmit="App.handleRegister(event)">
                                <!-- Role Selector -->
                                <div class="mb-4 p-3 bg-light rounded">
                                    <label class="form-label fw-bold small text-muted d-block mb-2">I want to register
                                        as:</label>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <input type="radio" class="btn-check" name="regRole" id="regRoleCustomer"
                                                value="CUSTOMER" checked>
                                            <label class="btn btn-outline-primary w-100 py-2" for="regRoleCustomer">
                                                <i class="bi bi-person me-1"></i> Customer
                                            </label>
                                        </div>
                                        <div class="col-6">
                                            <input type="radio" class="btn-check" name="regRole" id="regRoleProvider"
                                                value="PROVIDER">
                                            <label class="btn btn-outline-info w-100 py-2" for="regRoleProvider">
                                                <i class="bi bi-tools me-1"></i> Service Provider
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="regFullName" class="form-label small fw-semibold">Full Name</label>
                                    <input type="text" id="regFullName" class="form-control" placeholder="John Doe"
                                        required minlength="2">
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label for="regEmail" class="form-label small fw-semibold">Email Address</label>
                                        <input type="email" id="regEmail" class="form-control"
                                            placeholder="name@example.com" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="regPhone" class="form-label small fw-semibold">Phone Number</label>
                                        <input type="tel" id="regPhone" class="form-control" placeholder="+1-555-0199"
                                            required>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="regAddress" class="form-label small fw-semibold">Service / Home
                                        Address</label>
                                    <input type="text" id="regAddress" class="form-control"
                                        placeholder="Street Address, City, Postal Code" required minlength="3">
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <label for="regPassword" class="form-label small fw-semibold">Password</label>
                                        <input type="password" id="regPassword" class="form-control"
                                            placeholder="Min 6 characters" required minlength="6">
                                    </div>
                                    <div class="col-md-6">
                                        <label for="regConfirmPassword" class="form-label small fw-semibold">Confirm
                                            Password</label>
                                        <input type="password" id="regConfirmPassword" class="form-control"
                                            placeholder="Re-enter password" required minlength="6">
                                    </div>
                                </div>

                                <button type="submit" id="btnRegisterSubmit"
                                    class="btn btn-primary w-100 py-2 fw-semibold">
                                    Complete Registration
                                </button>
                            </form>

                            <div class="mt-4 text-center small text-muted">
                                Already have an account?
                                <a href="#login" onclick="App.navigateTo('login')" class="fw-semibold">Sign In Here</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- ============================================================= -->
        <!-- VIEW 4: CUSTOMER DASHBOARD -->
        <!-- ============================================================= -->
        <section id="view-customer" class="view-section py-4" style="display: none;">
            <div class="container">
                <!-- Welcome Banner & KPIs -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h2 class="fw-bold mb-1">Customer Dashboard</h2>
                        <p class="text-muted mb-0">Welcome back, <span id="customerWelcomeName"
                                class="fw-semibold text-primary">Customer</span>!</p>
                    </div>
                    <div class="mt-2 mt-sm-0">
                        <button class="btn btn-outline-primary btn-sm" onclick="Customer.init()">
                            <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
                        </button>
                    </div>
                </div>

                <!-- KPI Counters -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-icon bg-primary text-white"><i class="bi bi-calendar2-range"></i></div>
                            <div>
                                <h3 class="fw-bold mb-0" id="custStatTotal">0</h3>
                                <span class="small text-muted">Total Bookings</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-icon bg-warning text-dark"><i class="bi bi-hourglass-split"></i></div>
                            <div>
                                <h3 class="fw-bold mb-0" id="custStatPending">0</h3>
                                <span class="small text-muted">Pending Confirmation</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-icon bg-info text-white"><i class="bi bi-check-circle"></i></div>
                            <div>
                                <h3 class="fw-bold mb-0" id="custStatActive">0</h3>
                                <span class="small text-muted">Accepted / In-Progress</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-icon bg-success text-white"><i class="bi bi-patch-check"></i></div>
                            <div>
                                <h3 class="fw-bold mb-0" id="custStatCompleted">0</h3>
                                <span class="small text-muted">Completed</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Dashboard Tabs Navigation -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-2">
                        <ul class="nav nav-pills nav-fill" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link cust-nav-btn active fw-semibold" id="btn-cust-tab-explore"
                                    onclick="App.showCustomerTab('explore')">
                                    <i class="bi bi-search me-2"></i> Browse Services & Providers
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link cust-nav-btn fw-semibold" id="btn-cust-tab-bookings"
                                    onclick="App.showCustomerTab('bookings')">
                                    <i class="bi bi-calendar2-check me-2"></i> My Bookings History
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link cust-nav-btn fw-semibold" id="btn-cust-tab-profile"
                                    onclick="App.showCustomerTab('profile')">
                                    <i class="bi bi-person-gear me-2"></i> Profile & Settings
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Tab 1: Browse Providers -->
                <div id="cust-tab-explore" class="cust-tab-content">
                    <!-- Search & Filter Bar -->
                    <div class="card border-0 shadow-sm mb-4 p-3">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-5">
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent border-end-0"><i
                                            class="bi bi-search text-muted"></i></span>
                                    <input type="text" id="custSearchInput" class="form-control border-start-0"
                                        placeholder="Search by service name, provider, keyword..."
                                        oninput="Customer.filterProviders()">
                                </div>
                            </div>
                            <div class="col-md-5">
                                <select id="custServiceFilter" class="form-select"
                                    onchange="Customer.filterProviders()">
                                    <option value="">All Service Categories</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-outline-secondary w-100"
                                    onclick="document.getElementById('custSearchInput').value = ''; document.getElementById('custServiceFilter').value = ''; Customer.filterProviders()">
                                    <i class="bi bi-x-circle me-1"></i> Reset
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Providers Grid -->
                    <div id="custProvidersGrid" class="row">
                        <!-- Populated dynamically via Customer.renderProviders() -->
                    </div>
                </div>

                <!-- Tab 2: My Bookings -->
                <div id="cust-tab-bookings" class="cust-tab-content" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">My Bookings</h5>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary active"
                                onclick="Customer.renderBookings('')">All</button>
                            <button type="button" class="btn btn-outline-warning"
                                onclick="Customer.renderBookings('PENDING')">Pending</button>
                            <button type="button" class="btn btn-outline-primary"
                                onclick="Customer.renderBookings('ACCEPTED')">Accepted</button>
                            <button type="button" class="btn btn-outline-success"
                                onclick="Customer.renderBookings('COMPLETED')">Completed</button>
                            <button type="button" class="btn btn-outline-secondary"
                                onclick="Customer.renderBookings('CANCELLED')">Cancelled</button>
                        </div>
                    </div>
                    <div id="custBookingsList">
                        <!-- Populated dynamically via Customer.renderBookings() -->
                    </div>
                </div>

                <!-- Tab 3: Customer Profile & Settings -->
                <div id="cust-tab-profile" class="cust-tab-content" style="display: none;">
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="card shadow-sm border-0 p-4">
                                <h5 class="fw-bold mb-3"><i class="bi bi-person me-2 text-primary"></i> Contact &
                                    Address Info</h5>
                                <form id="custProfileForm" onsubmit="Customer.updateProfile(event)">
                                    <div class="mb-3">
                                        <label for="custProfileEmail" class="form-label small fw-semibold">Email Address
                                            (Read-only)</label>
                                        <input type="email" id="custProfileEmail" class="form-control" disabled>
                                    </div>
                                    <div class="mb-3">
                                        <label for="custProfileName" class="form-label small fw-semibold">Full
                                            Name</label>
                                        <input type="text" id="custProfileName" class="form-control" required
                                            minlength="2">
                                    </div>
                                    <div class="mb-3">
                                        <label for="custProfilePhone" class="form-label small fw-semibold">Phone
                                            Number</label>
                                        <input type="tel" id="custProfilePhone" class="form-control" required>
                                    </div>
                                    <div class="mb-3">
                                        <label for="custProfileAddress" class="form-label small fw-semibold">Default
                                            Service Address</label>
                                        <textarea id="custProfileAddress" class="form-control" rows="3"
                                            required></textarea>
                                    </div>
                                    <button type="submit" id="btnCustSaveProfile" class="btn btn-primary fw-semibold">
                                        Save Changes
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="card shadow-sm border-0 p-4">
                                <h5 class="fw-bold mb-3"><i class="bi bi-shield-lock me-2 text-primary"></i> Change
                                    Password</h5>
                                <form id="custChangePassForm" onsubmit="Customer.changePassword(event)">
                                    <div class="mb-3">
                                        <label for="custOldPassword" class="form-label small fw-semibold">Current
                                            Password</label>
                                        <input type="password" id="custOldPassword" class="form-control" required>
                                    </div>
                                    <div class="mb-3">
                                        <label for="custNewPassword" class="form-label small fw-semibold">New
                                            Password</label>
                                        <input type="password" id="custNewPassword" class="form-control" required
                                            minlength="6">
                                    </div>
                                    <div class="mb-4">
                                        <label for="custConfirmPassword" class="form-label small fw-semibold">Confirm
                                            New Password</label>
                                        <input type="password" id="custConfirmPassword" class="form-control" required
                                            minlength="6">
                                    </div>
                                    <button type="submit" id="btnCustChangePass"
                                        class="btn btn-outline-primary fw-semibold">
                                        Update Password
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>


        <!-- ============================================================= -->
        <!-- VIEW 5: PROVIDER DASHBOARD -->
