                        <li class="mb-2"><a href="#register"
                                onclick="App.navigateTo('register'); document.getElementById('regRoleCustomer').checked = true;">Customer
                                Sign Up</a></li>
                        <li class="mb-2"><a href="#register"
                                onclick="App.navigateTo('register'); document.getElementById('regRoleProvider').checked = true;">Join
                                as Provider</a></li>
                        <li class="mb-2"><a href="#login"
                                onclick="App.navigateTo('login'); App.fillDemoLogin('ADMIN')">Admin Portal</a></li>
