                                    <i class="bi bi-play-circle me-2"></i> Active Jobs
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link prov-nav-btn fw-semibold" id="btn-prov-tab-services"
                                    onclick="App.showProviderTab('services')">
                                    <i class="bi bi-card-checklist me-2"></i> My Service Offers
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link prov-nav-btn fw-semibold" id="btn-prov-tab-history"
                                    onclick="App.showProviderTab('history')">
                                    <i class="bi bi-clock-history me-2"></i> History
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link prov-nav-btn fw-semibold" id="btn-prov-tab-profile"
                                    onclick="App.showProviderTab('profile')">
                                    <i class="bi bi-person-gear me-2"></i> Profile
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Tab 1: Incoming Requests -->
                <div id="prov-tab-requests" class="prov-tab-content">
                    <h5 class="fw-bold mb-3">Incoming Booking Requests</h5>
                    <div id="provRequestsList">
                        <!-- Populated dynamically via Provider.renderRequests() -->
                    </div>
                </div>

                <!-- Tab 2: Active Jobs -->
                <div id="prov-tab-active" class="prov-tab-content" style="display: none;">
                    <h5 class="fw-bold mb-3">Active & Scheduled Jobs</h5>
                    <div id="provActiveJobsList">
                        <!-- Populated dynamically via Provider.renderActiveJobs() -->
                    </div>
                </div>

