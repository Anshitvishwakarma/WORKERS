                                <span class="small text-muted">Pending Requests</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-icon bg-primary text-white"><i class="bi bi-tools"></i></div>
                            <div>
                                <h3 class="fw-bold mb-0" id="provStatActive">0</h3>
                                <span class="small text-muted">Active Scheduled Jobs</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-icon bg-success text-white"><i class="bi bi-patch-check"></i></div>
