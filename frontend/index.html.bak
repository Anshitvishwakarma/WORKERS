                <!-- Tab 4: History -->
                <div id="prov-tab-history" class="prov-tab-content" style="display: none;">
                    <h5 class="fw-bold mb-3">Past Job History</h5>
                    <div id="provHistoryList">
                        <!-- Populated dynamically via Provider.renderHistory() -->
