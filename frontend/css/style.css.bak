/* =====================================================================
   FixMate Modern Professional CSS Stylesheet
   Color Palette: Deep Navy (#0f172a), Royal Blue (#1e40af), Accent (#3b82f6)
   ===================================================================== */

:root {
    --primary-blue: #1e40af;
    --primary-hover: #1d4ed8;
    --secondary-blue: #3b82f6;
    --navy-dark: #0f172a;
    --navy-light: #1e293b;
    --accent-warning: #f59e0b;
    --accent-success: #10b981;
    --accent-danger: #ef4444;
    --body-bg: #f8fafc;
    --card-bg: #ffffff;
    --text-main: #1e293b;
    --text-muted: #64748b;
    --border-color: #e2e8f0;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
}

[data-bs-theme="dark"] {
    --body-bg: #0b1120;
    --card-bg: #151e33;
    --text-main: #f1f5f9;
    --text-muted: #94a3b8;
    --border-color: #1e293b;
    --navy-dark: #070d18;
}

body {
    font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    background-color: var(--body-bg);
    color: var(--text-main);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

main {
    flex: 1;
}

/* Typography & Links */
a {
    color: var(--secondary-blue);
    text-decoration: none;
    transition: color 0.2s ease;
}
a:hover {
    color: var(--primary-hover);
}

/* Navigation Bar */
.navbar-fixmate {
    background: var(--navy-dark);
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}
.navbar-brand-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 1.4rem;
    color: #ffffff !important;
    letter-spacing: -0.5px;
}
.brand-icon {
    color: #60a5fa;
}

/* Hero Section */
.hero-section {
    background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
    color: #ffffff;
    padding: 90px 0 80px 0;
    position: relative;
    overflow: hidden;
}
.hero-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle at 80% 20%, rgba(59, 130, 246, 0.25) 0%, transparent 50%);
    pointer-events: none;
}
.hero-title {
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    line-height: 1.2;
}
.hero-subtitle {
    font-size: 1.2rem;
    color: #cbd5e1;
}
.hero-search-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    padding: 24px;
}

/* Card Styling */
.card {
    background-color: var(--card-bg);
    border-color: var(--border-color);
    border-radius: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.card:hover {
    box-shadow: var(--shadow-md);
}

/* Service & Provider Cards */
.service-icon-box {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: rgba(59, 130, 246, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
}
.service-icon-box-sm {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: rgba(59, 130, 246, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
}
.service-item-card {
    border: 1px solid var(--border-color);
    border-radius: 14px;
}
.service-item-card:hover {
    transform: translateY(-4px);
    border-color: var(--secondary-blue);
}
.provider-card {
    border: 1px solid var(--border-color);
}
.provider-card:hover {
    transform: translateY(-3px);
}

/* Stats / KPI Widget */
.kpi-card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
}
.kpi-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}

/* Dashboard Sidebars & Sub-Navs */
.dash-sidebar {
    background-color: var(--card-bg);
    border-radius: 12px;
    border: 1px solid var(--border-color);
    padding: 16px;
}
.dash-nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    color: var(--text-muted);
    font-weight: 500;
    border-radius: 8px;
    transition: all 0.2s ease;
    border: none;
    width: 100%;
    text-align: left;
    background: transparent;
}
.dash-nav-link:hover {
    background-color: rgba(59, 130, 246, 0.08);
    color: var(--secondary-blue);
}
.dash-nav-link.active {
    background-color: var(--primary-blue);
    color: #ffffff;
}

/* Tables */
.table {
    --bs-table-bg: transparent;
    color: var(--text-main);
}
.table > :not(caption) > * > * {
    background-color: transparent;
    border-bottom-color: var(--border-color);
    padding: 12px 16px;
}
.table-hover > tbody > tr:hover > * {
    background-color: rgba(59, 130, 246, 0.04);
}

/* Badges */
.badge {
    padding: 6px 10px;
    font-weight: 600;
    letter-spacing: 0.2px;
}

/* Empty States */
.empty-state {
    padding: 48px 24px;
    text-align: center;
}
.empty-icon {
    font-size: 3.5rem;
    color: var(--text-muted);
    opacity: 0.6;
    margin-bottom: 16px;
    display: inline-block;
}

/* Toast Container */
#toastContainer {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    min-width: 320px;
    max-width: 420px;
}

/* Loading Overlay */
#globalLoadingSpinner {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
}

/* Footer */
.footer-fixmate {
    background-color: var(--navy-dark);
    color: #94a3b8;
    padding: 48px 0 24px 0;
    border-top: 1px solid rgba(255,255,255,0.08);
}
.footer-fixmate h6 {
    color: #ffffff;
    font-weight: 700;
    margin-bottom: 16px;
}
.footer-fixmate a {
    color: #94a3b8;
}
.footer-fixmate a:hover {
    color: #ffffff;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .hero-title {
        font-size: 2.1rem;
    }
    .hero-section {
        padding: 60px 0 40px 0;
    }
}


#view-home .hero-section {
    background-image:
        linear-gradient(
            rgba(7, 25, 48, 0.75),
            rgba(7, 25, 48, 0.75)
        ),
        url("https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80");

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

/* Service cards */
.service-item-card {
    overflow: hidden;
    border-radius: 16px !important;
    background: #fff;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.service-item-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12) !important;
}

/* Service photo */
.service-photo-wrapper {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: #edf3f8;
}

.service-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
}

.service-item-card:hover .service-photo {
    transform: scale(1.06);
}

.service-card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
}

.service-item-card .card-title {
    color: #17324d;
    font-size: 1.05rem;
}

.service-item-card .card-text {
    line-height: 1.6;
}

@media (max-width: 576px) {
    .service-photo-wrapper {
        height: 200px;
    }
}
.testimonial-photo {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: 50%;
    object-fit: cover;
    margin-right: 12px;
    border: 2px solid #e9eef5;
}
/* Testimonial cards background photo */
.testimonial-bg {
    background-image:
        linear-gradient(rgba(255, 255, 255, 0.88),
                        rgba(255, 255, 255, 0.88)),
        url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80');

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 16px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.testimonial-bg:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.15) !important;
}
.testimonial-section {
    background:
        linear-gradient(rgba(225, 239, 255, 0.78),
                        rgba(225, 239, 255, 0.78)),
        url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1800&q=85');

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: scroll;
    padding: 50px 0;
}

.testimonial-section .card {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(5px);
    border-radius: 16px;
}

.testimonial-section .card:hover {
    transform: translateY(-5px);
    transition: transform 0.3s ease;
}



.service-item-card {
    overflow: hidden;
    border-radius: 16px !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.service-item-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12) !important;
}

.service-photo-wrapper {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: #edf3f8;
}

.service-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.service-card-content {
    display: flex;
    flex-direction: column;
    height: calc(100% - 180px);
}

@media (max-width: 576px) {
    .service-photo-wrapper {
        height: 200px;
    }
}

:root {
    --text-color: #212529;
    --bg-color: #ffffff;
    --card-bg: #ffffff;
}

[data-theme="dark"] {
    --text-color: #030e0e;
    --bg-color: #121826;
    --card-bg: #1e293b;
}

body {
    color: var(--text-color);
    background-color: var(--bg-color);
}

.card {
    color: var(--text-color);
    background-color: var(--card-bg);
}





